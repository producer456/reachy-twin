# reachy-twin config -- copy to .env and fill in. (.env is gitignored)

# --- Claude brain ("Hey Claude") ---
# Leave ANTHROPIC_API_KEY blank to use the Claude Code CLI on your subscription
# (no API cost). Set it to use the Anthropic API directly instead.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# --- Marcus brain ("Hey Marcus") -- your own LLM endpoint ---
# POST {"message": "..."} -> SSE stream of {"text": <cumulative>} ending {"done": true}
# On the same host: http://localhost:PORT  | over a network: http://HOST:PORT
MARCUS_URL=

# --- Local brain (on-device LLM, the DEFAULT engine) ---
# An OpenAI-compatible endpoint on the host itself -- e.g. `mlx_lm.server` on
# Apple Silicon (no GPU server needed). Blank LOCAL_URL disables it (falls back
# to Marcus then Claude). The hard/tool queries still detour to Marcus.
#   pip install mlx-lm  &&  mlx_lm.server --model mlx-community/Qwen3-4B-4bit --port 8081
LOCAL_URL=http://127.0.0.1:8081
LOCAL_MODEL=mlx-community/Qwen3-4B-4bit

# --- Speech-to-text ---
WHISPER_MODEL=base.en
WHISPER_COMPUTE=int8

# --- Voices (Kokoro) ---
CLAUDE_VOICE=am_michael
MARCUS_VOICE=af_heart
LOCAL_VOICE=bf_lily
